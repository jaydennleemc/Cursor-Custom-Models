{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursor Gateway",
  "mainBinaryName": "Cursor Gateway",
  "version": "1.0.9",
  "identifier": "com.cursorgateway.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cursor Gateway",
        "width": 1080,
        "height": 760,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwNjNEQTBENkExRDdFMDcKUldRSGZoMXFEZHBqRUhCTHE1TXd6a2RzMmJYWGdGbjNtTkprc1NDalA2eUZiZHNobm5EdTZvc08K",
      "endpoints": [
        "https://github.com/jaydennleemc/Cursor-Custom-Models/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
