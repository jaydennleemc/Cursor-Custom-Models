{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursor Gateway",
  "mainBinaryName": "Cursor Gateway",
  "version": "1.0.3",
  "identifier": "com.cursorgateway.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cursor Gateway",
        "width": 1080,
        "height": 760,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
